# Copy to .env; never commit real secrets. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-64-character-secret-before-starting
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# URL-encode reserved characters if constructing DATABASE_URL yourself.
POSTGRES_DB=n2ncp
POSTGRES_USER=n2ncp
POSTGRES_PASSWORD=replace-with-a-random-hex-database-password
DATABASE_URL=postgresql://n2ncp:replace-with-a-random-hex-database-password@db:5432/n2ncp
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=n2ncp <hello@localhost>
# Production: DEBUG=0, real host/site URL, SMTP credentials, and these Caddy settings.
DOMAIN=cp.example.com
ACME_EMAIL=admin@example.com
WEB_WORKERS=2

# Linux development bind-mount ownership; set these to id -u / id -g if different.
LOCAL_UID=1000
LOCAL_GID=1000
